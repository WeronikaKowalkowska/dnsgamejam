config_version=5

[application]

config/name="DNJ4"
run/main_scene="uid://beyxdwc5xx6t6"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.12941177, 0.14509805, 0.19607843, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://dd7bh8w28aktt"
config/icon="res://assets/icon.svg"

[autoload]

Const="*uid://c7k6d8gtnu15v"
Colors="*uid://lbdf085j60r3"
Utils="*uid://bh4pwq1xu774q"
Scenes="*uid://bhnllpjy4ikoy"
Signals="*uid://cqh5ec4u7ayid"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="DNJ4"

[editor_plugins]

enabled=PackedStringArray("res://addons/kanban_tasks/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "red"
}

[global_group]

